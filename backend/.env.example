# Server Configuration
PORT=5000

# Database Configuration
# MongoDB connection string - Replace with your MongoDB Atlas or local MongoDB URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Authentication
# Generate a secure random string for JWT token signing
JWT_SECRET=your_jwt_secret_key_here

# Environment
NODE_ENV=development

# Google OAuth Credentials
# Get these from Google Cloud Console (https://console.cloud.google.com)
# Create OAuth 2.0 credentials and add authorized redirect URIs
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI Assistant Configuration
OPENROUTER_API_KEY=your_openrouter_api_key

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay Configuration (test mode) — get these from
# https://dashboard.razorpay.com/app/keys after switching to "Test Mode"
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
