# Server Configuration
PORT=5000

# Database Configuration
# MongoDB connection string - Replace with your MongoDB Atlas or local MongoDB URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Authentication
# Generate a secure random string for JWT token signing
JWT_SECRET=your_jwt_secret_key_here

# Environment
NODE_ENV=development

# Google OAuth Credentials
# Get these from Google Cloud Console (https://console.cloud.google.com)
# Create OAuth 2.0 credentials and add authorized redirect URIs
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI Assistant Configuration
OPENROUTER_API_KEY=your_openrouter_api_key

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay Configuration (test mode) — get these from
# https://dashboard.razorpay.com/app/keys after switching to "Test Mode"
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Resend Email Configuration (https://resend.com/api-keys)
# Used to send each user a recurring documents digest: every
# DOCUMENT_EMAIL_INTERVAL_HOURS, they get emailed all documents (uploads +
# draft + final) for any service completed since their last digest — or a
# "no services completed" notice if none were.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Vithartha Consulting <noreply@yourdomain.com>"

# How often, in hours, each user's documents digest repeats. E.g. 720 = 30
# days ("once a month"), 168 = 7 days ("once a week"), 24 = daily.
DOCUMENT_EMAIL_INTERVAL_HOURS=720
# How often (in minutes) the backend checks which users are due for their
# next digest. Should be smaller than DOCUMENT_EMAIL_INTERVAL_HOURS.
AUTO_EMAIL_CHECK_INTERVAL_MINUTES=15
# Set to "false" to disable the digest sweep entirely.
AUTO_EMAIL_DOCUMENTS_ENABLED=true
